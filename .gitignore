# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/tmp/presstuner-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# AI agent and local automation state
/.agent-work/
/.hermes/
/.omo/
/.agents/
/.codex/
/.codegraph

# local editor and browser-test artifacts
/.idea/
/.vscode/
/playwright-report/
/test-results/
/blob-report/

# isolated Python candidate runtime
/ai-service/.venv/
/ai-service/.pytest_cache/
/ai-service/.ruff_cache/
/ai-service/.langgraph_api/
/ai-service/**/__pycache__/
