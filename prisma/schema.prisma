  @@index([questionId, createdAt])
  @@map("question_ai_message")
}

// 3.5. 문항-브릭 연결 (Join Table)
model QuestionOnBrick {
  questionId String   @map("question_id")
  brickId    String   @map("brick_id")
  createdAt  DateTime @default(now()) @map("created_at")

  isAiSuggested Boolean @default(false) @map("is_ai_suggested") // AI가 처음에 추천했는지?
