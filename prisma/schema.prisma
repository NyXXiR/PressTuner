model AgentStep {
  id                  String          @id @default(cuid()) @map("id")
  runId               String          @map("run_id")
  sequence            Int             @map("sequence")
  kind                String          @map("kind")
  toolName            String?         @map("tool_name")
  status              AgentStepStatus @default(PENDING) @map("status")
  idempotencyKey      String          @unique @map("idempotency_key")
  inputSummary        Json?           @map("input_summary")
  outputSummary       Json?           @map("output_summary")
  model               String?         @map("model")
  inputTokens         Int             @default(0) @map("input_tokens")
  outputTokens        Int             @default(0) @map("output_tokens")
  cachedInputTokens   Int             @default(0) @map("cached_input_tokens")
  estimatedCostMicros Int             @default(0) @map("estimated_cost_micros")
  latencyMs           Int?            @map("latency_ms")
  retryCount          Int             @default(0) @map("retry_count")
  errorCode           String?         @map("error_code")
  errorMessage        String?         @map("error_message") @db.Text
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  run              AgentRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals        AgentApproval[]
  retrievedSources AgentRetrievedSource[]
  citations        AgentCitation[]

  @@unique([runId, sequence])
  @@index([runId, status])
  @@map("agent_step")
}

model AgentApproval {
  id            String              @id @default(cuid()) @map("id")
  runId         String              @map("run_id")
  stepId        String?             @map("step_id")
  requestedById String              @map("requested_by_id")
  decidedById   String?             @map("decided_by_id")
  toolName      String              @map("tool_name")
  status        AgentApprovalStatus @default(PENDING) @map("status")
  toolInput     Json                @map("tool_input")
  decisionNote  String?             @map("decision_note") @db.Text
  requestedAt   DateTime            @default(now()) @map("requested_at")
  decidedAt     DateTime?           @map("decided_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  run         AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step        AgentStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  requestedBy User       @relation("AgentApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?      @relation("AgentApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@map("agent_approval")
}

model AgentRetrievedSource {
  id           String   @id @default(cuid()) @map("id")
  runId        String   @map("run_id")
