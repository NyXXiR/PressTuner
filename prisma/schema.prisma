// 1. 경험 브릭 (Experience Brick)
model ExperienceBrick {
  id     String  @id @default(cuid()) @map("id")
  userId String  @map("user_id")
  teamId String? @map("team_id") // 팀 공용 브릭일 경우 사용

  title                String                       @map("title")
  content              String                       @map("content") @db.Text
  originalText         String?                      @map("original_text") @db.Text
  period               String?                      @map("period")
  startDate            DateTime?                    @map("start_date")
  tags                 String[]                     @map("tags")
  source               BrickSource                  @default(MANUAL) @map("source")
  organization         String?                      @map("organization")
  roleTitle            String?                      @map("role_title")
  experienceType       CareerExperienceType         @default(OTHER) @map("experience_type")
  endDate              DateTime?                    @map("end_date")
  isCurrent            Boolean                      @default(false) @map("is_current")
  actions              String[]                     @default([]) @map("actions")
  outcomes             String[]                     @default([]) @map("outcomes")
  metrics              String[]                     @default([]) @map("metrics")
  tools                String[]                     @default([]) @map("tools")
  memoryStatus         CareerExperienceStatus       @default(CONFIRMED) @map("memory_status")
  confirmedAt          DateTime?                    @map("confirmed_at")
  confirmedByUserId    String?                      @map("confirmed_by_user_id")
  embedding            Unsupported("vector(1536)")?
  embeddingContentHash String?                      @map("embedding_content_hash")
  embeddingModel       String?                      @map("embedding_model")
  embeddedAt           DateTime?                    @map("embedded_at")
  embeddingRevision    Int                          @default(0) @map("embedding_revision")
  embeddedRevision     Int?                         @map("embedded_revision")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  usedInQuestions  QuestionOnBrick[]
  candidateTargets CareerExperienceCandidate[]       @relation("CareerCandidateTarget")
  careerFacts      CareerFact[]
  answerGroundings CareerAnswerGroundingExperience[]

  @@index([userId, startDate])
  @@index([teamId])
  @@map("experience_brick")
}

// 2. 지원 프로젝트 (Application)
model Application {
  id     String  @id @default(cuid()) @map("id")
  userId String  @map("user_id")
  teamId String? @map("team_id")

  companyName           String               @map("company_name")
  jobTitle              String               @map("job_title")
  jdText                String?              @map("jd_text") @db.Text
  clientRequestId       String?              @map("client_request_id")
  brief                 Json?                @map("brief")
  commonWritingGuidance String[]             @default([]) @map("common_writing_guidance")
  strategyStatus        ResumeStrategyStatus @default(PENDING) @map("strategy_status")
  strategyError         Json?                @map("strategy_error")
  strategyUpdatedAt     DateTime?            @map("strategy_updated_at")

  status   ApplicationStatus @default(WRITING) @map("status")
  deadline DateTime?         @map("deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                          Team?                          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questions                     Question[]
  careerFinalAnswerCaptureTasks CareerFinalAnswerCaptureTask[]

  @@unique([userId, clientRequestId])
  @@index([userId, status])
  @@index([teamId])
  @@index([deadline])
  @@map("application")
}

// 3. 개별 문항 (Question)
model Question {
  id            String @id @default(cuid()) @map("id")
  applicationId String @map("application_id")

  questionText String  @map("question_text") @db.Text
  charLimit    Int?    @map("char_limit")
  answer       String? @map("answer") @db.Text
  aiAdvice     String? @map("ai_advice") @db.Text
  order        Int     @default(0) @map("order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application                   Application                    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  relatedBricks                 QuestionOnBrick[]
  suggestions                   SuggestionTicket[]
  aiMessages                    QuestionAiMessage[]
  careerCandidates              CareerExperienceCandidate[]
  careerCaptureProposals        CareerCaptureProposal[]
  careerFinalAnswerCaptureTasks CareerFinalAnswerCaptureTask[]
  careerGroundings              CareerAnswerGrounding[]
  careerVerifications           CareerAnswerVerification[]
  isCompleted                   Boolean                        @default(false)
  answerRevision                Int                            @default(0) @map("answer_revision")

  @@index([applicationId, order])
  @@map("question")
}

model QuestionAiMessage {
  id         String                @id @default(cuid()) @map("id")
  questionId String                @map("question_id")
  role       QuestionAiMessageRole @map("role")
  kind       QuestionAiMessageKind @map("kind")
  content    String                @map("content") @db.Text
  meta       Json?                 @map("meta")
