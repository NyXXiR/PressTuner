  discountDurationMonths Int?            @map("discount_duration_months")

  // Plan grant benefit (e.g., 1 month PRO)
  grantPlanId       String?       @map("grant_plan_id")
  grantPlanType     PlanType?     @map("grant_plan_type")
  grantPlanCategory PlanCategory? @map("grant_plan_category")
  grantMonths       Int?          @map("grant_months")

