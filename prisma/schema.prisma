  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_grounding_state")
}

model ArticleEvidenceCandidate {
  id                      String                  @id @default(cuid()) @map("id")
  articleId               String                  @map("article_id")
  teamId                  String                  @map("team_id")
  documentId              String                  @map("document_id")
  chunkId                 String                  @map("chunk_id")
  content                 String                  @map("content") @db.Text
  pageStart               Int                     @map("page_start")
  pageEnd                 Int                     @map("page_end")
  excerpt                 String                  @map("excerpt") @db.Text
  score                   Float                   @map("score")
  decision                ArticleEvidenceDecision @default(PENDING) @map("decision")
  discoveredCorpusVersion Int                     @map("discovered_corpus_version")
  decidedAt               DateTime?               @map("decided_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  article  Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  chunk    KnowledgeChunk    @relation(fields: [chunkId], references: [id], onDelete: Restrict)
  fact     ArticleFact?

  @@unique([articleId, chunkId])
  @@index([teamId, articleId, decision])
  @@map("article_evidence_candidate")
}

model ArticleFact {
  id          String            @id @default(cuid()) @map("id")
  articleId   String            @map("article_id")
  teamId      String            @map("team_id")
  candidateId String?           @unique @map("candidate_id")
  origin      ArticleFactOrigin @map("origin")
  sourceKey   String?           @map("source_key")
  content     String            @map("content") @db.Text
  active      Boolean           @default(true) @map("active")
  documentId  String?           @map("document_id")
  chunkId     String?           @map("chunk_id")
  pageStart   Int?              @map("page_start")
  pageEnd     Int?              @map("page_end")
  excerpt     String?           @map("excerpt") @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  article        Article                   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  team           Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  candidate      ArticleEvidenceCandidate? @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  document       KnowledgeDocument?        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  chunk          KnowledgeChunk?           @relation(fields: [chunkId], references: [id], onDelete: Restrict)
  draftEvidence  ArticleDraftEvidence[]
  finalCitations ArticleFinalCitation[]

  @@unique([articleId, sourceKey])
  @@index([teamId, articleId, active])
  @@map("article_fact")
}

model ArticleDraftEvidence {
  id        String   @id @default(cuid()) @map("id")
  articleId String   @map("article_id")
  factId    String   @map("fact_id")
  draftHash String   @map("draft_hash")
  createdAt DateTime @default(now()) @map("created_at")

  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fact    ArticleFact @relation(fields: [factId], references: [id], onDelete: Restrict)

  @@unique([articleId, draftHash, factId])
  @@index([articleId, draftHash])
  @@map("article_draft_evidence")
}

model ArticleVerification {
  id                String                    @id @default(cuid()) @map("id")
  articleId         String                    @map("article_id")
  teamId            String?                   @map("team_id")
  draftHash         String                    @map("draft_hash")
  groundingRevision Int                       @map("grounding_revision")
  corpusVersion     Int                       @map("corpus_version")
  verifierVersion   String                    @map("verifier_version")
  modelVersion      String                    @map("model_version")
  result            ArticleVerificationResult @map("result")
  createdAt         DateTime                  @default(now()) @map("created_at")

  article        Article                      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  team           Team?                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  findings       ArticleVerificationFinding[]
  finalCitations ArticleFinalCitation[]

  @@index([articleId, createdAt])
  @@index([teamId, createdAt])
  @@map("article_verification")
}

model ArticleVerificationFinding {
  id              String                          @id @default(cuid()) @map("id")
  verificationId  String                          @map("verification_id")
  type            ArticleVerificationFindingType  @map("type")
  riskCategory    ArticleVerificationRiskCategory @map("risk_category")
  result          ArticleVerificationResult       @map("result")
  claim           String                          @map("claim") @db.Text
  explanation     String                          @map("explanation") @db.Text
  evidenceFactIds String[]                        @map("evidence_fact_ids")
  createdAt       DateTime                        @default(now()) @map("created_at")

  verification ArticleVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, result])
  @@map("article_verification_finding")
}

model ArticleFinalCitation {
  id             String   @id @default(cuid()) @map("id")
  articleId      String   @map("article_id")
  teamId         String?  @map("team_id")
  verificationId String   @map("verification_id")
  factId         String   @map("fact_id")
  documentId     String   @map("document_id")
  chunkId        String   @map("chunk_id")
  pageStart      Int      @map("page_start")
  pageEnd        Int      @map("page_end")
  excerpt        String   @map("excerpt") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  article      Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  team         Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  verification ArticleVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  fact         ArticleFact         @relation(fields: [factId], references: [id], onDelete: Restrict)
  document     KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  chunk        KnowledgeChunk      @relation(fields: [chunkId], references: [id], onDelete: Restrict)

  @@unique([verificationId, factId])
  @@index([articleId, createdAt])
  @@index([documentId, pageStart])
  @@map("article_final_citation")
}

