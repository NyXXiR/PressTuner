// ---------------------------------------------------------
// [MODELS]
// ---------------------------------------------------------

model Team {
  id   String @id @default(cuid()) @map("id")
  slug String @unique @map("slug")
  name String @map("name")

  // --- [Billing & Plan Info] ---

  // 1. 플랜 식별 정보
  planId String?  @map("plan_id") // SKU (예: 'career_pro_v1', 'basic_monthly_v1')
  plan   PlanType @default(FREE) @map("plan") // 등급 (BASIC, PRO...)

  // ✅ [NEW] 플랜 카테고리 (트랙)
  // 기존 유저는 모두 보도자료 유저이므로 default(PRESS)로 마이그레이션(어차피 FREE는 카테고리 크게 상관없음)
  planCategory PlanCategory @default(PRESS) @map("plan_category")

  // 2. 결제 정보 (스냅샷 & 스케줄링)
  membershipStatus MembershipStatus         @default(ACTIVE) @map("membership_status")
  payProvider      SubscriptionPayProvider? @map("pay_provider")

  billingKey    String?   @map("billing_key")
  nextBillingAt DateTime? @map("next_billing_at")

  // ✅ [NEW] 다음 결제일에 실제로 청구할 금액 (원화 기준)
  // - 할인, 가격 인상/유지(Grandfathering) 등을 반영한 최종 금액 스냅샷
  nextPaymentAmount Int? @default(0) @map("next_payment_amount")

  planExpiresAt DateTime? @map("plan_expires_at")

  // 다운그레이드/변경 예약
  pendingPlanId       String?   @map("pending_plan_id")
  pendingPlan         PlanType? @map("pending_plan")
  pendingPlanStartsAt DateTime? @map("pending_plan_starts_at")

  cancelRequestedAt DateTime? @map("cancel_requested_at")
  lastPaymentId     String?   @map("last_payment_id")
  lastPaidAt        DateTime? @map("last_paid_at")

  // ------------------------------------------------------------
  // ✅ [NEW] 쿼터(Limit) 및 사용량(Usage) - 스냅샷 방식
  // 결제/갱신 시점에 plans.ts의 스펙을 이곳에 '복사'해둡니다.
  // ------------------------------------------------------------

  // 1. 보도자료 (Article)
  limitArticleMonthly Int @default(0) @map("limit_article_monthly")
  usageArticleMonthly Int @default(0) @map("usage_article_monthly")

  // 2. 자소서/이력서 (Resume)
  limitResumeMonthly Int @default(0) @map("limit_resume_monthly")
  usageResumeMonthly Int @default(0) @map("usage_resume_monthly")

  // (구 충전식 크레딧 - 레거시 호환용)
  credits Int @default(0) @map("credits")

  // --- [Settings] ---
  model                  String  @default("gpt-4.1-mini") @map("model")
  feedbackEnabled        Boolean @default(true) @map("feedback_enabled")
  knowledgeCorpusVersion Int     @default(0) @map("knowledge_corpus_version")

  // ✅ 기능 토글 (플랜에 따라 아예 UI를 가릴 때 사용)
  resumeEnabled Boolean @default(false) @map("resume_enabled")

  // ✅ 팀 권한 정책
  allowMemberEdit     Boolean @default(false) @map("allow_member_edit")
  allowMemberFinalize Boolean @default(false) @map("allow_member_finalize")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productSubscriptions TeamProductSubscription[]

  // Relations
  examples                  ExampleArticle[]
  articles                  Article[]
  feedbacks                 Feedback[]
  usageLogs                 UsageLog[]
  feedbackBlocks            FeedbackBlock[]
  members                   TeamMember[]
  styleGuides               StyleGuide[]
  styleGuideDefaults        StyleGuideDefault[]
  invitations               TeamInvitation[]
  sessions                  Session[]                  @relation("SessionTeam")
  notices                   Notice[]
  notifications             Notification[]
  billingOrders             BillingOrder[]
  creditLedgers             CreditLedger[]
  billingHistories          TeamBillingHistory[]
  checkoutIntents           CheckoutIntent[]
  subscriptionChanges       SubscriptionChange[]
  articleUsageEvents        ArticleUsageEvent[]
  reviewAssignments         ArticleReviewAssignment[]
  couponRedemptions         CouponRedemption[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeChunks           KnowledgeChunk[]
  knowledgeUploadEvents     KnowledgeUploadEvent[]
  agentRuns                 AgentRun[]
  agentRunFeedbacks         AgentRunFeedback[]
  articleEvidenceCandidates ArticleEvidenceCandidate[]
  articleFacts              ArticleFact[]
  articleVerifications      ArticleVerification[]
  articleFinalCitations     ArticleFinalCitation[]

  // ✅ 자소서 관련 역참조
  experienceBricks ExperienceBrick[]
  applications     Application[]

  @@index([plan, membershipStatus])
  @@index([planExpiresAt])
  @@index([nextBillingAt])
  @@map("team")
}

model TeamProductSubscription {
  id                  String                   @id @default(cuid()) @map("id")
  teamId              String                   @map("team_id")
  product             ProductLine              @map("product")
  planId              String?                  @map("plan_id")
  plan                PlanType                 @default(FREE) @map("plan")
  membershipStatus    MembershipStatus         @default(ACTIVE) @map("membership_status")
  payProvider         SubscriptionPayProvider? @map("pay_provider")
  billingKey          String?                  @map("billing_key")
  nextPaymentAmount   Int                      @default(0) @map("next_payment_amount")
  nextBillingAt       DateTime?                @map("next_billing_at")
  planExpiresAt       DateTime?                @map("plan_expires_at")
  pendingPlanId       String?                  @map("pending_plan_id")
  pendingPlan         PlanType?                @map("pending_plan")
  pendingPlanStartsAt DateTime?                @map("pending_plan_starts_at")
  cancelRequestedAt   DateTime?                @map("cancel_requested_at")
  lastPaymentId       String?                  @map("last_payment_id")
  lastPaidAt          DateTime?                @map("last_paid_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, product])
  @@index([product, membershipStatus])
  @@index([nextBillingAt])
  @@index([planExpiresAt])
  @@map("team_product_subscription")
}

model UsageLog {
  id String @id @default(cuid()) @map("id")

  teamId String  @map("team_id")
  userId String? @map("user_id")

  action UsageAction @map("action")
  model  String      @map("model")

  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")
  totalTokens  Int @default(0) @map("total_tokens")

  cost Int @map("cost")

  targetId String? @map("target_id")
  meta     Json?   @map("meta")

  createdAt DateTime @default(now()) @map("created_at")

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([teamId, createdAt])
  @@map("usage_log")
}

model AiQuotaOverride {
  id              String   @id @default(cuid()) @map("id")
  key             String   @unique @map("key")
  kind            String   @map("kind")
  planId          String?  @map("plan_id")
  surface         String?  @map("surface")
  action          String?  @map("action")
  windowKey       String?  @map("window_key")
  limitUnits      Int?     @map("limit_units")
  actionUnits     Int?     @map("action_units")
  enabled         Boolean  @default(true) @map("enabled")
  note            String?  @map("note")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([kind, planId, surface])
  @@index([kind, action])
  @@map("ai_quota_override")
}

model User {
  id String @id @default(cuid()) @map("id")

  loginId  String  @unique @map("login_id")
  label    String  @map("label")
  email    String? @unique @map("email")
  password String? @map("password")

  avatarUrl         String?   @map("avatar_url")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  deleteScheduledAt DateTime? @map("delete_scheduled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  careerMemoryVersion Int @default(0) @map("career_memory_version")

  // Relations
  articles                   Article[]
  feedbacks                  Feedback[]
  usageLogs                  UsageLog[]
  feedbackBlocks             FeedbackBlock[]
  memberships                TeamMember[]
  invitationsSent            TeamInvitation[]          @relation("Inviter")
  invitationsReceived        TeamInvitation[]          @relation("Invitee")
  oauthAccounts              OAuthAccount[]
  sessions                   Session[]
  createdNotices             Notice[]                  @relation("NoticeCreatedBy")
  notificationsReceived      Notification[]            @relation("NotificationToUser")
  readNotifications          NotificationRead[]
  billingOrders              BillingOrder[]
  billingHistories           TeamBillingHistory[]
  checkoutIntents            CheckoutIntent[]
  articleUsageEvents         ArticleUsageEvent[]
  reviewAssignmentsReceived  ArticleReviewAssignment[] @relation("ReviewAssignee")
  reviewAssignmentsGiven     ArticleReviewAssignment[] @relation("ReviewAssignedBy")
  activities                 UserArticleActivity[]
  couponRedemptions          CouponRedemption[]
  uploadedKnowledgeDocuments KnowledgeDocument[]       @relation("KnowledgeDocumentUploader")
  knowledgeUploadEvents      KnowledgeUploadEvent[]
  startedAgentRuns           AgentRun[]                @relation("AgentRunStartedBy")
  agentRunFeedbacks          AgentRunFeedback[]
  requestedAgentApprovals    AgentApproval[]           @relation("AgentApprovalRequestedBy")
  decidedAgentApprovals      AgentApproval[]           @relation("AgentApprovalDecidedBy")

  // ✅ 자소서 관련 역참조
  experienceBricks              ExperienceBrick[]
  applications                  Application[]
  careerSources                 CareerSource[]
  careerCandidates              CareerExperienceCandidate[]    @relation("CareerCandidateOwner")
  reviewedCareerCandidates      CareerExperienceCandidate[]    @relation("CareerCandidateReviewer")
  careerCaptureProposals        CareerCaptureProposal[]
  careerFinalAnswerCaptureTasks CareerFinalAnswerCaptureTask[]
  careerFacts                   CareerFact[]
  careerGroundings              CareerAnswerGrounding[]
  careerVerifications           CareerAnswerVerification[]
  careerVerificationOverrides   CareerVerificationOverride[]

  @@index([label])
  @@map("user")
}

model Article {
  id     String  @id @default(cuid()) @map("id")
  teamId String? @map("team_id")
  userId String? @map("user_id")

  status ArticleStatus @default(BRIEF) @map("status")
  type   ArticleType   @default(PRESS_RELEASE) @map("type")

  title            String  @map("title")
  bodyJson         Json?   @map("body_json")
  lastPolishResult Json?   @map("last_polish_result")
  rawInput         String? @map("raw_input")
  refinementQna    Json?   @map("refinement_qna")

  styleScore   Int?    @map("style_score")
  styleSummary String? @map("style_summary")

  styleGuideId String? @map("style_guide_id")

  isShared   Boolean @default(false) @map("is_shared") // 공유 활성화 여부
  shareToken String? @unique @map("share_token") // 공유용 고유 토큰 (UUID or NanoID)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  styleGuide         StyleGuide?                @relation(fields: [styleGuideId], references: [id], onDelete: SetNull)
  team               Team?                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user               User?                      @relation(fields: [userId], references: [id])
  feedbacks          Feedback[]
  blogExtra          BlogExtra?                 @relation("Article_BlogExtra")
  resumeExtra        ResumeExtra?               @relation("Article_ResumeExtra")
  pressExtra         PressExtra?                @relation("Article_PressExtra")
  styleSignals       StyleSignal[]
  usageStat          ArticleUsageStat?
  usageEvents        ArticleUsageEvent[]
  reviewAssignments  ArticleReviewAssignment[]
  activities         UserArticleActivity[]
  agentRuns          AgentRun[]
  groundingState     ArticleGroundingState?
  evidenceCandidates ArticleEvidenceCandidate[]
  facts              ArticleFact[]
  draftEvidence      ArticleDraftEvidence[]
  verifications      ArticleVerification[]
  finalCitations     ArticleFinalCitation[]

  @@index([teamId, status, createdAt])
  @@index([styleGuideId])
  @@map("article")
}

model ExampleArticle {
  id        String   @id @default(cuid()) @map("id")
  teamId    String   @map("team_id")
  title     String   @map("title")
  body      String   @map("body")
  source    String   @default("generated") @map("source")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])

  @@map("example_article")
}

model Feedback {
  id        String       @id @default(cuid()) @map("id")
  teamId    String       @map("team_id")
  articleId String       @map("article_id")
  userId    String?      @map("user_id")
  vote      FeedbackVote @map("vote")
  comment   String?      @map("comment")
  createdAt DateTime     @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([articleId, createdAt])
  @@map("feedback")
}

model FeedbackBlock {
  id        String   @id @default(cuid()) @map("id")
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@map("feedback_block")
}

model TeamMember {
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER) @map("role")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_member")
}

// --- Subtype Extras ---

model BlogExtra {
  articleId String   @id @map("article_id")
  summary   String?  @map("summary")
  tags      String[] @map("tags")
  coverUrl  String?  @map("cover_url")
  article   Article  @relation("Article_BlogExtra", fields: [articleId], references: [id], onDelete: Cascade)

  @@map("blog_extra")
}

model ResumeExtra {
  articleId String  @id @map("article_id")
  headline  String? @map("headline")
  sections  Json?   @map("sections")
  qaDrafts  Json?   @map("qa_drafts")
  meta      Json?   @map("meta")
  article   Article @relation("Article_ResumeExtra", fields: [articleId], references: [id], onDelete: Cascade)

  @@map("resume_extra")
}

model PressExtra {
  articleId String  @id @map("article_id")
  lead      String? @map("lead")
  fact      String? @map("fact")
  article   Article @relation("Article_PressExtra", fields: [articleId], references: [id], onDelete: Cascade)

  @@map("press_extra")
}

// --- Style system ---

model StyleGuide {
  id                 String  @id @default(cuid())
  teamId             String  @map("team_id")
  name               String  @map("name")
  description        String? @map("description")
  isArchived         Boolean @default(false) @map("is_archived")
  isDefault          Boolean @default(false) @map("is_default")
  basePrompt         String? @map("base_prompt") @db.Text
  config             Json?   @map("config")
  pendingSignalCount Int     @default(0) @map("pending_signal_count")
  isCompiling        Boolean @default(false) @map("is_compiling")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team     Team                @relation(fields: [teamId], references: [id])
  compiled GuideCompiled?
  signals  StyleSignal[]
  articles Article[]
  defaults StyleGuideDefault[]

  @@index([teamId, isDefault])
  @@map("style_guide")
}

model StyleGuideDefault {
