{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "worked_on",
    "source",
    "learning",
    "evidence",
    "format_version",
    "project_ids",
    "publication"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "worked_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "실제 작업일. 모르면 null. 등록일로 대체하지 않습니다."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "reference"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "ai",
            "human",
            "mixed",
            "unknown"
          ]
        },
        "reference": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "scope",
        "decision",
        "verification",
        "limitations",
        "questions",
        "concepts"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "verification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "guide"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,64}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "\\S"
              },
              "guide": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            }
          }
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "body",
              "url",
              "source",
              "definition"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "\\S"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^$|^https://[^\\s]+$",
                "description": "HTTPS reference, or empty when no source has been verified."
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "definition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S",
                "description": "General meaning; keep separate from body, the actual application."
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "string",
      "maxLength": 20000
    },
    "format_version": {
      "type": "integer",
      "const": 4
    },
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "publication": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "description": "draft is not visible in Interview Lab; publish only after explicit human review."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview Lab archive record v4"
}
