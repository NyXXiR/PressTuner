{
  "name": "presstuner",
  "version": "0.1.0",
  "description": "AI-assisted press release and career-document workspace with measurable RAG and Agent evaluation workflows",
  "homepage": "https://www.briefflow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NyXXiR/PressTuner.git"
  },
  "bugs": {
    "url": "https://github.com/NyXXiR/PressTuner/issues"
  },
  "keywords": [
    "nextjs",
    "rag",
    "ai-agents",
    "press-release",
    "career-writing",
    "portfolio"
  ],
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "predev": "npm run prisma:generate",
    "dev": "next dev -p 3003",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "prestart": "npm run prisma:generate",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "test:font-contract": "node --import tsx --test lib/offlineFontLoading.test.ts",
    "test:runner": "node --test scripts/run-tests.test.mjs",
    "ai-process-console:artifacts": "node --import tsx scripts/exportAiProcessConsoleArtifacts.ts",
    "ai-process-console:artifacts:check": "node --import tsx scripts/exportAiProcessConsoleArtifacts.ts --check",
    "ai-process-console:worker": "node --import tsx scripts/runAiProcessConsoleProducerWorker.ts",
    "test:db:setup": "node scripts/setup-test-database.mjs",
    "qa:core-local": "node scripts/run-core-rag-qa.mjs",
    "qa:press-new-api": "node scripts/run-press-new-api-qa.mjs",
    "qa:press-agent-operation": "node --import tsx scripts/run-press-agent-operation-qa.mjs",
    "qa:rag-debugger": "node --import tsx scripts/run-press-ai-debugger-qa.ts",
    "qa:press-ai-debugger": "node --import tsx scripts/run-press-ai-debugger-qa.ts",
    "qa:press-ai-scenario": "node --import tsx scripts/run-press-ai-scenario-qa.ts",
    "verify:presstuner-debug-integration": "node --import tsx scripts/verifyPresstunerDebugIntegration.ts",
    "eval:press-rag": "node --import tsx scripts/evaluatePressRag.ts",
    "eval:press-ai-debugger:ci": "node --import tsx scripts/evaluatePressAiTransitions.ts",
    "eval:press-rag-controlled-live": "node --import tsx scripts/runPressRagControlledLive.ts",
    "compare:press-rag-controlled-live": "node --import tsx scripts/comparePressRagControlledLive.ts",
    "gate:press-rag-controlled-live": "node --import tsx scripts/evaluatePressRagControlledLiveGate.ts",
    "generate:press-rag-judge-review": "node --import tsx scripts/generateJudgeCalibrationReview.ts",
    "approve:press-rag-judge-review": "node --import tsx scripts/approveJudgeCalibrationReview.ts",
    "run:press-rag-judge-calibration": "node --import tsx scripts/runJudgeCalibration.ts",
    "generate:press-rag-interview-answer": "node --import tsx scripts/generatePressRagInterviewAnswer.ts",
    "verify:press-rag-interview-answer": "node --import tsx scripts/verifyPressRagInterviewAnswer.ts",
    "generate:press-rag-controlled-live-cycle": "node --import tsx scripts/generatePressRagControlledLiveCycle.ts",
    "experiment:press-rag": "node --import tsx scripts/runPressRagExperiment.ts",
    "generate:press-rag-improvement": "node --import tsx scripts/generatePressRagImprovementCycle.ts",
    "generate:press-rag-execution-evidence": "node --import tsx scripts/generatePressRagExecutionEvidence.ts",
    "generate:press-rag-experiment-cycle": "node --import tsx scripts/generatePressRagExperimentCycle.ts",
    "verify:press-rag-artifacts": "node scripts/verifyPressRagArtifacts.mjs",
    "generate:rag-capability-matrix": "node scripts/generateRagCapabilityMatrix.mjs",
    "verify:rag-capability-matrix": "node scripts/generateRagCapabilityMatrix.mjs --check",
    "report:press-agent": "tsx scripts/reportPressAgentObservability.ts",
    "qa-auth:configure": "tsx scripts/configureAiQaAuth.ts",
    "smoke:portone:billing": "tsx scripts/portoneBillingSmoke.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.0.10",
    "@openai/agents": "^0.13.5",
    "@portone/browser-sdk": "^0.1.1",
    "@portone/server-sdk": "^0.18.0",
    "@prisma/client": "^6.9.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@tosspayments/tosspayments-sdk": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "langsmith": "^0.8.9",
    "lucide-react": "^0.562.0",
    "next": "^16.0.7",
    "next-themes": "^0.4.6",
    "openai": "^6.9.1",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-textarea-autosize": "^8.5.9",
    "unpdf": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
