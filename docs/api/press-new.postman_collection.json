{
  "info": {
    "_postman_id": "a9514809-a8e7-4fd6-aeb7-press-new-flow",
    "name": "PressTuner /press/new API QA",
    "description": "로컬 QA 전용: 로그인부터 보도자료 FINAL 완료까지 순서대로 실행합니다. qaSecret은 환경의 Current value에만 입력하고 내보내지 마세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
